# ========================================================
# NexRAG Enterprise - Environment Configuration
# ========================================================

# LLM Provider: "mock" (default, free offline mode), "openai", "groq", "ollama"
LLM_PROVIDER=mock

# OpenAI Configuration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (optional high-speed free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Ollama Local Configuration (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Embedding & Retrieval Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RERANK_TOP_K=3
RRF_K=60
SPARSE_WEIGHT=0.4
DENSE_WEIGHT=0.6

# Guardrails & Safety
ENABLE_GUARDRAILS=true
PII_REDACTION_ENABLED=true
INJECTION_THRESHOLD=0.65
FAITHFULNESS_THRESHOLD=0.70
